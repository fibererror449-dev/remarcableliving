# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# internal working documents — must not reach this public repository.
# CODEX-AUDIT-BRIEF.md contains work-status/legal analysis, a personal phone
# number, listing-provenance findings and local filesystem paths.
/AGENTS.md
/CODEX-AUDIT-BRIEF.md

# platform config: carries the Sites project id. Required by vite.config.ts,
# so a fresh clone cannot build without it being supplied separately.
/.openai/
